{
  "layer": "top",
  "position": "top",
  "reload_style_on_change": true,
  "passthrough": false,

  // Floating bar: gaps around it, modules grouped into "islands"
  "height": 34,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 5,
  "margin-right": 5,
  "margin-bottom": 0,

  "modules-left": ["custom/icon", "hyprland/workspaces"],
  "modules-center": ["clock", "mpris", "group/media-controls"],
  "modules-right": [
    "tray",
    "group/hardware",
    "hyprland/language",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "power-profiles-daemon",
    "battery"
  ],

  "custom/icon": {
    "format": "",
    "tooltip": false,
    "on-click": "hyprlauncher"
  },

  "hyprland/window": {
    "separate-outputs": true,
    "max-length": 40,
    "format": "{class}",
    "rewrite": {
      "": "Arch",
      "kitty": "Terminal",
      "vesktop": "Discord",
      "zen": "Browser",
      "firefox": "Firefox",
      "code": "VS Code",
      "com.microsoft.VSCode": "VS Code"
    }
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "on-click": "activate",
    "format": "{name}"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 8,
    "show-passive-items": true
  },

  // CPU / RAM / temp, collapsed behind an icon; hover expands to the left
  "group/hardware": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "children-class": "hardware-child",
      "transition-left-to-right": false
    },
    "modules": ["custom/hardware", "cpu", "memory", "temperature"]
  },

  "custom/hardware": {
    "format": "󰍛",
    "tooltip": false
  },

  "cpu": {
    "interval": 3,
    "format": "  {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": "  {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
  },

  "temperature": {
    "critical-threshold": 85,
    "format": " {temperatureC}°",
    "format-critical": " {temperatureC}°"
  },

  // Keyboard layout (br / us-intl); click or Super+Space switches
  "hyprland/language": {
    "format": "󰌌  {short}",
    "format-br": "󰌌  BR",
    "format-us": "󰌌  US",
    "on-click": "hyprctl switchxkblayout all next"
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "󰝟  muted",
    "format-bluetooth": "{icon}",
    "tooltip-format": "Volume: {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  // Left click opens the menu; right click toggles power
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "{controller_alias}  ·  {status}",
    "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
    "on-click": "~/.config/waybar/scripts/bluetooth.sh",
    "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%"
  },


  // Click cycles through the profiles
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰓅",
      "performance": "󰓅",
      "balanced": "󰗑",
      "power-saver": "󰌪"
    }
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{capacity}%  ·  {timeTo}  ·  {power:.1f}W"
  },

  // Media player (any MPRIS player); hidden when nothing is playing
  "mpris": {
    "format": "󰝚  {dynamic}",
    "format-paused": "󰝚  <i>{dynamic}</i>",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 40,
    "dynamic-separator": " · ",
    "tooltip-format": "{player}: {title}\n{artist}  ·  {album}\n{position} / {length}",
    "interval": 1,
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // Previous / play-pause / next buttons; hidden when there is no player
  "group/media-controls": {
    "orientation": "horizontal",
    "modules": ["custom/media-prev", "custom/media-play-pause", "custom/media-next"]
  },

  "custom/media-prev": {
    "exec": "~/.config/waybar/scripts/media.sh prev",
    "tooltip-format": "Previous",
    "on-click": "playerctl previous"
  },

  "custom/media-play-pause": {
    "exec": "~/.config/waybar/scripts/media.sh play-pause",
    "tooltip-format": "Play / Pause",
    "on-click": "playerctl play-pause"
  },

  "custom/media-next": {
    "exec": "~/.config/waybar/scripts/media.sh next",
    "tooltip-format": "Next",
    "on-click": "playerctl next"
  },

  "clock": {
    "format": "󰥔  {:%H:%M}",
    "format-alt": "󰃰  {:%a, %d %b}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "",
      "format": {
        "months": "<span color='#bb9af7'><b>{}</b></span>",
        "weekdays": "<span color='#7aa2f7'><b>{}</b></span>",
        "today": "<span color='#e0af68'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  }
}
